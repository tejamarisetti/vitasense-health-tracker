# VitaSense AI Assistant API Configuration
# Copy this file to .env and configure your API key.
# .env is gitignored and must NEVER be committed or exposed to the frontend.

# LLM API Key for assistant intent routing and contextual health responses
# Supported providers: Gemini (GEMINI_API_KEY), OpenAI (OPENAI_API_KEY), or generic VITASENSE_LLM_API_KEY
GEMINI_API_KEY=
OPENAI_API_KEY=
VITASENSE_LLM_API_KEY=

# Server configuration
API_HOST=0.0.0.0
API_PORT=8000

# Authentication & Demo Endpoint configuration
# ENABLE_DEMO_LOGIN defaults to false (disabled). Set to 'true' only to enable the demo login endpoint.
ENABLE_DEMO_LOGIN=false
